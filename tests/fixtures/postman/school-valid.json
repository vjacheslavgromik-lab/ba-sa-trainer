{
  "info": {
    "name": "API учебной школы",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Студенты",
      "item": [
        {
          "name": "Список студентов",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код ответа 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            }
          }
        },
        {
          "name": "Студент по id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код ответа 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                ":id"
              ]
            }
          }
        },
        {
          "name": "Студент не найден",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код ответа 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "9999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Записи",
      "item": [
        {
          "name": "Записать студента на курс",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код ответа 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/enrollments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "enrollments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"student_id\": 1, \"course_id\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Запись с неверными данными",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код ответа 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/enrollments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "enrollments"
              ]
            },
            "body": {
